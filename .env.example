# Copy this file to .env and fill in real values, then restart the server.

# ---- App login (single-user password gate for the local UI) ----
APP_PASSWORD=change-me
SESSION_SECRET=change-this-to-a-random-string
PORT=3000

# ---- eBay (official Sell Inventory API) ----
# Create a Production keyset at https://developer.ebay.com/my/keys
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Generate via eBay's OAuth "authorization code" user consent flow once,
# then keep reusing the resulting refresh token (long-lived, ~18 months).
EBAY_REFRESH_TOKEN=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_DEFAULT_CATEGORY_ID=
EBAY_MARKETPLACE_ID=EBAY_GB

# eBay's API needs publicly reachable image URLs (it fetches them itself).
# Point this at a public https URL for this app (e.g. an ngrok/Cloudflare
# tunnel, or wherever you deploy it) so /uploads/<file> resolves publicly.
PUBLIC_BASE_URL=https://your-public-url.example.com

# ---- Browser-automation marketplaces ----
# No API keys. Run `npm run login -- facebook_marketplace` (or vinted /
# depop) once to save a logged-in session, then leave BROWSER_DRY_RUN=1
# until you've confirmed a dry run looks right on your account.
VINTED_DOMAIN=www.vinted.co.uk
BROWSER_DRY_RUN=1
BROWSER_HEADLESS=1
